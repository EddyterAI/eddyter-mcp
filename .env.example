# The Eddyter license key the agent acts on behalf of.
# Created by the admin in the dashboard at https://www.eddyter.com/user/license-key
# (The MCP never generates keys — humans mint them in the portal.)
EDDYTER_LICENSE_KEY=eddyt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Eddyter environment to talk to: "production" (default) | "staging" | "local"
# Most users never set this.
EDDYTER_ENV=production

# Opt-in: expose config-changing tools (update_config). OFF by default — reads
# (verify_status, get_config, get_usage) always work; set this to true only when
# you want the agent to be able to change the live editor.
# EDDYTER_ALLOW_WRITES=true

# Advanced override: full base URL (takes precedence over EDDYTER_ENV).
# e.g. http://localhost:3000
# EDDYTER_API_BASE_URL=
